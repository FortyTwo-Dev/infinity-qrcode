{
  "name": "infinity-qrcode",
  "version": "3.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run type-check && bun run test && bun run test:unit",
    "format": "prettier --write src/ tests/ e2e/ *.ts *.js",
    "governance:sync": "ibrain sync",
    "governance:check": "ibrain sync --check",
    "governance:list": "ibrain list",
    "check:all": "bun run check && bun run test:e2e"
  },
  "dependencies": {
    "@infinitylib/infinity-theme": "^0.1.0",
    "iqrcode-learn-wasm": "0.1.0",
    "iqrcode-wasm": "0.1.0",
    "vue": "3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
